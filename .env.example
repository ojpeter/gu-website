# Copy this file to .env and fill in real values. Never commit .env itself.

APP_ENV=development
APP_NAME="Gulu University"
APP_BASE_URL=http://localhost/gu-website/

DB_HOST=localhost
DB_NAME=gu_website
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Single entry point to the eServices Portal (gu-services project).
# Dev: the sibling project's own landing page under XAMPP.
# Prod: the dedicated subdomain — see requirements.md Section 3.6.
ESERVICES_URL=http://localhost/gu-services

# Read-only bridge into gu-services' database (requirements.md Section 3.3,
# CLAUDE.md Rule 9) — a dedicated least-privilege MySQL account with SELECT
# only on the cms_* content tables. Never reuse DB_USER/DB_PASS for this.
GU_SERVICES_DB_HOST=localhost
GU_SERVICES_DB_NAME=gu_hrms
GU_SERVICES_DB_USER=gu_website_reader
GU_SERVICES_DB_PASS=
GU_SERVICES_DB_CHARSET=utf8mb4
GU_SERVICES_BASE_URL=http://localhost/gu-services/

SESSION_COOKIE_NAME=gu_website_session
